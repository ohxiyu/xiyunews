# ============================================
# QweCryptoMonitor 配置文件示例
# 复制此文件为 .env 并填入真实值
# 警告: .env 文件绝不能提交到版本控制!
# ============================================

# --- Telegram Bot 配置 (必填) ---
# 从 @BotFather 获取 Token
TELEGRAM_BOT_TOKEN=your_bot_token_here
# 频道/群组 ID (如 @channelname 或数字ID)
TELEGRAM_CHAT_ID=your_chat_id_here
# 管理员 ID (用于接收系统日报，可选)
TELEGRAM_ADMIN_ID=your_admin_id_here

# --- Redis 配置 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- 日志级别 ---
# 可选: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Binance API (通常无需修改) ---
# BINANCE_SPOT_API=https://api.binance.com/api/v3/ticker/24hr
# BINANCE_FUTURES_API=https://fapi.binance.com/fapi/v1/exchangeInfo
# BINANCE_WS_URL=wss://stream.binance.com:9443
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/ws
