[Unit]
Description=FomoBTC market and announcement monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fomobtc
Group=fomobtc
WorkingDirectory=/opt/fomobtc/current
EnvironmentFile=/etc/fomobtc.env
ExecStart=/opt/fomobtc/current/venv/bin/python /opt/fomobtc/current/run.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fomobtc
StateDirectory=fomobtc
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fomobtc
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
