# Telegram is fail-closed by default. Set false only for intentional log-only mode.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_channel_or_chat_id
TELEGRAM_ADMIN_ID=your_admin_chat_id
TELEGRAM_MAX_ATTEMPTS=4
TELEGRAM_DELIVERY_TIMEOUT_SECONDS=90

# Redis is optional. The monitor continues without persistent cooldowns if unavailable.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

LOG_LEVEL=INFO

# FomoBTC 2.0
FOMOBTC_DB=data/fomobtc.sqlite3
API_HOST=127.0.0.1
API_PORT=8080
FRONTEND_ORIGIN=
SOURCE_COMMIT=unknown
MARKET_ENABLED=true
ANNOUNCEMENTS_ENABLED=true
# A conservative group-compatible default; dedicated channels may use 1.1 after verification.
TELEGRAM_CHAT_INTERVAL=3.1
TELEGRAM_ANNOUNCEMENT_CHAT_ID=
BINANCE_ANNOUNCEMENT_API_KEY=
BINANCE_ANNOUNCEMENT_API_SECRET=
OKX_BASE_URL=https://www.okx.com
OKX_POLL_SECONDS=6
# Public preview fallback: 15 second polling, explicitly degraded and limited coverage.
HYPERLIQUID_POLL_SECONDS=15
# Optional authorized Telegram client; never provide phone login codes to the daemon.
HYPERLIQUID_SESSION=
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# Independent market switches; announcements are unaffected.
SPOT_ENABLED=true
FUTURES_ENABLED=false

# Independent market push policy (does not suppress collection)
