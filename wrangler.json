{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xiyunews",
  "main": "edge/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENABLE_REALTIME_WATCHDOG": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RECOVERY_GATE",
        "class_name": "RecoveryGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "xiyunews-recovery-transfer-20261003",
      "transferred_classes": [
        {
          "from": "RecoveryGate",
          "from_script": "bmtnews-daily-dispatcher",
          "to": "RecoveryGate"
        }
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "469346950dfc4f36b8d9bf9997d960fa"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "xiyu.news",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
