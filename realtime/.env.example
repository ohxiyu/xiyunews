# FomoBTC runtime configuration (production: /etc/fomobtc.env, root 0600). Never commit real values.

# Telegram is fail-closed by default. Set false only for intentional log-only mode.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Forum group id (scripts/setup_telegram_topics.sh fills this and the topic ids).
TELEGRAM_CHAT_ID=your_group_or_chat_id
TELEGRAM_TOPIC_MARKET=
TELEGRAM_TOPIC_ANNOUNCEMENT=
TELEGRAM_TOPIC_FLOW=
# Optional separate chat for announcements; leave empty when using topics.
TELEGRAM_ANNOUNCEMENT_CHAT_ID=
# Seconds between messages to one chat (Telegram allows about 20 per minute in a group).
TELEGRAM_CHAT_INTERVAL=3.1

LOG_LEVEL=INFO
FOMOBTC_DB=data/fomobtc.sqlite3
# Read-only health/events API; keep it on loopback behind the TLS proxy.
API_HOST=127.0.0.1
API_PORT=8080
SOURCE_COMMIT=unknown

# Collectors
MARKET_ENABLED=true
SPOT_ENABLED=true
ANNOUNCEMENTS_ENABLED=true
FLOWS_ENABLED=true
# Read-only Binance key for the official announcement stream (scripts/setup_binance_announcements.sh).
BINANCE_ANNOUNCEMENT_API_KEY=
BINANCE_ANNOUNCEMENT_API_SECRET=
OKX_BASE_URL=https://www.okx.com
OKX_POLL_SECONDS=6
# Hyperliquid public channel preview: 15 second polling, explicitly degraded.
HYPERLIQUID_POLL_SECONDS=15
