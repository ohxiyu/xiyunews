[Unit]
Description=xiyunews consistent encrypted databases backup

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/xiyunews-backup/backup.py
Nice=19
IOWeight=10
CPUQuota=20%
MemoryMax=128M
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/xiyunews /home/xiyunews-runner/backup-export -/home/xiyunews-runner/state
InaccessiblePaths=/etc/fomobtc.env /opt/xiyunews-runner /root
UMask=0077
