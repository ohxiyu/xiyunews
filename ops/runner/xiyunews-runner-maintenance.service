[Unit]
Description=Bounded xiyunews runner cache and diagnostic maintenance
After=xiyunews-runner.service

[Service]
Type=oneshot
User=xiyunews-runner
Group=xiyunews-runner
WorkingDirectory=/opt/xiyunews-runner
ExecStart=/opt/xiyunews-runner-maintenance.sh --apply
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/xiyunews-runner /home/xiyunews-runner
InaccessiblePaths=-/etc/fomobtc.env -/var/lib/fomobtc -/opt/fomobtc -/home/admin -/root
CPUQuota=20%
MemoryMax=128M
Nice=19
TimeoutStartSec=300
UMask=0077
