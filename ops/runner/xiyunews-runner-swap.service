[Unit]
Description=Bounded disk buffer for xiyunews build bursts
After=local-fs.target
Before=xiyunews-runner.service
ConditionPathExists=/var/lib/xiyunews-runner.swap

[Service]
Type=oneshot
ExecStart=/sbin/swapon --priority 10 /var/lib/xiyunews-runner.swap
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
