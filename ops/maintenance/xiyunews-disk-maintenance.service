[Unit]
Description=Whitelist-only disk maintenance without application restarts
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/xiyunews-disk-maintenance/disk_maintenance.py --apply
User=root
Group=root
Nice=19
IOSchedulingClass=idle
CPUQuota=20%
MemoryMax=256M
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/run /opt/xiyunews-runner /opt/hostedtoolcache/CodeQL /opt/10eth-ci/work /var/log/journal
ReadOnlyPaths=/home/xiyunews-runner/state /var/lib/fomobtc /opt/fomobtc /opt/10eth/releases /opt/keyc /var/backups/xiyunews
StandardOutput=journal
StandardError=journal
