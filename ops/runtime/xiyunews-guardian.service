[Unit]
Description=xiyunews bounded runner recovery and status

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/xiyunews-runtime/guardian.py
Nice=19
MemoryMax=64M
CPUQuota=10%
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xiyunews-runtime
InaccessiblePaths=/etc/fomobtc.env /var/lib/fomobtc /opt/fomobtc
